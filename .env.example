# Copy this file to .env.local and fill in the values you have.
# Leave a value empty to keep the placeholder shown on the site.
# Variables must start with VITE_ to be exposed to the browser.

# Contact form delivery: any URL that accepts a JSON POST
# (for example a Formspree endpoint such as https://formspree.io/f/your-id).
VITE_CONTACT_ENDPOINT=

# Shown on the site and used for the mailto link.
VITE_CONTACT_EMAIL=

# Social profiles. Full https:// URLs only.
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
